
index.html
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CYVORA INFO</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#071426;color:#eaf3ff;font-family:Arial,sans-serif}
header{background:#0d2039;padding:25px 15px;text-align:center;border-bottom:2px solid #168bff}
header h1{color:#38a5ff;margin:0;font-size:30px;letter-spacing:2px}
header p{color:#a9c8e8}
nav{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;padding:15px;background:#0a192c;position:sticky;top:0}
button{background:#126bc0;color:white;border:0;padding:11px 16px;border-radius:8px;cursor:pointer;font-weight:bold}
button:hover{background:#258ff0}
main{max-width:950px;margin:auto;padding:20px}
section{display:none;background:#10233d;padding:22px;border-radius:14px;margin-bottom:18px;border:1px solid #23466b}
section.active{display:block}
h2{color:#48aaff}
h3{color:#9bd0ff}
p,li{line-height:1.8}
.card{background:#0b1b30;padding:15px;border-radius:10px;margin:12px 0;border:1px solid #23466b}
input{padding:12px;border-radius:8px;border:1px solid #4b739d;background:#071426;color:white;width:100%;margin:8px 0}
.option{display:block;background:#0b1b30;padding:12px;margin:8px 0;border-radius:8px;cursor:pointer}
.option input{width:auto}
.result{padding:12px;margin-top:12px;border-radius:8px;background:#173b59}
footer{text-align:center;color:#8daac8;padding:25px}
</style>
</head>
<body>

<header>
<h1>CYVORA INFO</h1>
<p>منصتك التعليمية لاكتشاف عالم الأمن السيبراني</p>
</header>

<nav>
<button onclick="showPage('home')">الرئيسية</button>
<button onclick="showPage('lessons')">الدروس</button>
<button onclick="showPage('quiz')">الاختبارات</button>
<button onclick="showPage('progress')">التقدم</button>
<button onclick="showPage('daily')">التحدي اليومي</button>
<button onclick="showPage('tips')">النصائح</button>
<button onclick="showPage('profile')">ملفي</button>
</nav>

<main>

<section id="home" class="active">
<h2>مرحباً بك في CYVORA INFO</h2>
<p>ابدأ رحلتك في تعلم الأمن السيبراني، واكتشف كيف تحمي معلوماتك وأجهزتك من المخاطر الرقمية.</p>
<div class="card">
<h3>ماذا ستتعلم؟</h3>
<ul>
<li>أساسيات الأمن السيبراني.</li>
<li>إنشاء كلمات مرور قوية.</li>
<li>التعرف على التصيد الإلكتروني.</li>
<li>حماية الأجهزة والبيانات.</li>
</ul>
</div>
<button onclick="showPage('lessons')">ابدأ التعلم</button>
</section>

<section id="lessons">
<h2>الدروس التعليمية</h2>
<div class="card">
<h3>الدرس الأول: مقدمة الأمن السيبراني</h3>
<p>الأمن السيبراني هو حماية الأجهزة والشبكات والبيانات من الوصول غير المصرح به والهجمات الرقمية.</p>
<button onclick="completeLesson(0)">إكمال الدرس</button>
</div>
<div class="card">
<h3>الدرس الثاني: كلمات المرور</h3>
<p>استخدم كلمة مرور طويلة وفريدة، ولا تشاركها مع الآخرين، وفعّل التحقق بخطوتين.</p>
<button onclick="completeLesson(1)">إكمال الدرس</button>
</div>
<div class="card">
<h3>الدرس الثالث: التصيد الإلكتروني</h3>
<p>التصيد الإلكتروني محاولة لخداع المستخدم حتى يكشف معلوماته. تحقق دائماً من الروابط والمرسل.</p>
<button onclick="completeLesson(2)">إكمال الدرس</button>
</div>
<div class="card">
<h3>الدرس الرابع: التحديثات والنسخ الاحتياطي</h3>
<p>حدّث أجهزتك باستمرار، واحتفظ بنسخة احتياطية من ملفاتك المهمة.</p>
<button onclick="completeLesson(3)">إكمال الدرس</button>
</div>
</section>

<section id="quiz">
<h2>اختبار الأمن السيبراني</h2>
<p>اختر الإجابة الصحيحة لكل سؤال.</p>
<div id="quizArea"></div>
<button onclick="submitQuiz()">إرسال الإجابات</button>
<div id="quizResult" class="result"></div>
</section>

<section id="daily">
<h2>التحدي اليومي</h2>
<p id="dailyQuestion"></p>
<div id="dailyOptions"></div>
<button id="dailyButton" onclick="submitDaily()">إرسال الإجابة</button>
<div id="dailyResult" class="result"></div>
</section>

<section id="progress">
<h2>لوحة التقدم</h2>
<div class="card">
<p>النقاط: <strong id="points">0</strong></p>
<p>أفضل نتيجة: <strong id="best">0</strong></p>
<p>الدروس المكتملة: <strong id="lessonCount">0</strong> من 4</p>
<p>المستوى: <strong id="level">مبتدئ</strong></p>
</div>
<h3>إنجازاتك</h3>
<p id="achievements"></p>
</section>

<section id="tips">
<h2>النصيحة اليومية</h2>
<div class="card">
<h3 id="tipTitle">نصيحة رقم 1</h3>
<p id="tipText"></p>
<button onclick="nextTip()">النصيحة التالية</button>
</div>
</section>

<section id="profile">
<h2>ملفي الشخصي</h2>
<p>اسم المستخدم:</p>
<input id="username" placeholder="اكتب اسمك">
<button onclick="saveName()">حفظ الاسم</button>
<div class="card">
<p>الاسم: <strong id="savedName">زائر</strong></p>
<p>النقاط: <strong id="profilePoints">0</strong></p>
<p>حالة التعلم: <strong id="profileStatus">مستمر</strong></p>
</div>
</section>

</main>

<footer>
<p>CYVORA INFO © 2026</p>
<p>منصة تعليمية للتوعية بالأمن السيبراني</p>
</footer>

<script>
function getNumber(key){return Number(localStorage.getItem(key)||0)}
function setNumber(key,value){localStorage.setItem(key,value)}
let points=getNumber("cyvoraPoints");
let best=getNumber("cyvoraBest");
let lessons=JSON.parse(localStorage.getItem("cyvoraLessons")||"[false,false,false,false]");
let tipIndex=0;

function showPage(id){
document.querySelectorAll("main section").forEach(s=>s.classList.remove("active"));
document.getElementById(id).classList.add("active");
updateAll();
}

function addPoints(amount){
points+=amount;
setNumber("cyvoraPoints",points);
updateAll();
}

function completeLesson(index){
if(!lessons[index]){
lessons[index]=true;
localStorage.setItem("cyvoraLessons",JSON.stringify(lessons));
addPoints(10);
alert("أحسنت! حصلت على 10 نقاط.");
}else{
alert("لقد أكملت هذا الدرس سابقاً.");
}
updateAll();
}

const questions=[
{q:"ما المقصود بالأمن السيبراني؟",a:["حماية المعلومات والأجهزة","تصميم الصور","سرعة الإنترنت"],c:0},
{q:"ما أفضل كلمة مرور؟",a:["123456","اسمك فقط","كلمة طويلة وفريدة"],c:2},
{q:"ما التصيد الإلكتروني؟",a:["تحديث الجهاز","محاولة خداع المستخدم لسرقة بياناته","نسخ الملفات"],c:1},
{q:"لماذا نحدّث البرامج؟",a:["لزيادة المخاطر","لإصلاح الثغرات وتحسين الحماية","لحذف الإنترنت"],c:1},
{q:"ماذا تفعل عند وصول رابط مشبوه؟",a:["تفتحه فوراً","ترسله للجميع","لا تفتحه وتتحقق من مصدره"],c:2}
];

function renderQuiz(){
let html="";
questions.forEach((q,i)=>{
html+=`<div class="card"><h3>${i+1}. ${q.q}</h3>`;
q.a.forEach((a,j)=>{
html+=`<label class="option"><input type="radio" name="q${i}" value="${j}"> ${a}</label>`;
});
html+="</div>";
});
document.getElementById("quizArea").innerHTML=html;
}
function submitQuiz(){
let score=0;
questions.forEach((q,i)=>{
let selected=document.querySelector(`input[name="q${i}"]:checked`);
if(selected&&Number(selected.value)===q.c)score++;
});
let result=score*20;
if(result>best){best=result;setNumber("cyvoraBest",best);}
document.getElementById("quizResult").innerText=`نتيجتك: ${score} من 5 (${result} من 100)`;
updateAll();
}

const dailyQuestions=[
{q:"ما التصرف الصحيح مع رسالة تطلب كلمة مرورك؟",a:["إرسالها","تجاهلها والتحقق من المرسل","نشرها"],c:1,e:"لا تشارك كلمة مرورك مع أي شخص."},
{q:"ما فائدة التحقق بخطوتين؟",a:["طبقة حماية إضافية","إبطاء الجهاز","حذف الحساب"],c:0,e:"يساعد على حماية الحساب حتى لو عُرفت كلمة المرور."},
{q:"ماذا تفعل قبل تحميل ملف مجهول؟",a:["تحمله مباشرة","تتحقق من المصدر","ترسله لأصدقائك"],c:1,e:"تحقق من مصدر الملفات قبل تحميلها."},
{q:"كيف تحمي ملفاتك المهمة؟",a:["تحذف النسخ","تشاركها مع الجميع","تحتفظ بنسخة احتياطية"],c:2,e:"النسخ الاحتياطي يساعدك على استعادة ملفاتك."},
{q:"ما التصرف الصحيح عند ظهور تحديث أمني؟",a:["تثبيته من المصدر الرسمي","تجاهله دائماً","تحميله من رابط مجهول"],c:0,e:"التحديثات الأمنية تصلح مشكلات وثغرات معروفة."}
];

let today=new Date().toDateString();
let dayIndex=Math.floor((new Date()-new Date(new Date().getFullYear(),0,0))/86400000)%5;
function renderDaily(){
let q=dailyQuestions[dayIndex];
document.getElementById("dailyQuestion").innerText=q.q;
document.getElementById("dailyOptions").innerHTML=q.a.map((a,i)=>`<label class="option"><input type="radio" name="daily" value="${i}"> ${a}</label>`).join("");
let attempt=localStorage.getItem("cyvoraDailyAttempt");
let feedback=localStorage.getItem("cyvoraDailyFeedback");
if(attempt===today){
document.querySelectorAll('input[name="daily"]').forEach(x=>x.disabled=true);
document.getElementById("dailyButton").disabled=true;
document.getElementById("dailyResult").innerText=feedback||"لقد أجبت عن تحدي اليوم.";
}else{
document.getElementById("dailyButton").disabled=false;
document.getElementById("dailyResult").innerText="";
}
}
function submitDaily(){
let selected=document.querySelector('input[name="daily"]:checked');
if(!selected){alert("اختر إجابة أولاً.");return;}
let q=dailyQuestions[dayIndex];
let correct=Number(selected.value)===q.c;
let rewardKey="cyvoraDailyRewarded_"+dayIndex;
let message=correct?"إجابة صحيحة! "+q.e:"إجابة غير صحيحة. الإجابة الصحيحة: "+q.a[q.c]+". "+q.e;
if(correct&&!localStorage.getItem(rewardKey)){
addPoints(10);
localStorage.setItem(rewardKey,"yes");
message+=" حصلت على 10 نقاط!";
}
localStorage.setItem("cyvoraDailyAttempt",today);
localStorage.setItem("cyvoraDailyFeedback",message);
renderDaily();
}

const tips=[
"لا تستخدم كلمة المرور نفسها في كل حساباتك.",
"فعّل التحقق بخطوتين.",
"لا تضغط على الروابط المشبوهة.",
"حدّث نظام التشغيل والتطبيقات.",
"لا تشارك رموز التحقق مع أحد.",
"استخدم المواقع الرسمية.",
"احتفظ بنسخة احتياطية من ملفاتك.",
"تحقق من عنوان المرسل قبل فتح المرفقات.",
"لا تنشر معلوماتك الشخصية بلا حاجة.",
"استخدم قفل الشاشة على جهازك.",
"تجنب شبكات الواي فاي العامة عند التعامل مع بيانات حساسة.",
"أخبر شخصاً موثوقاً إذا تعرض حسابك لمحاولة اختراق."
];
function renderTip(){
document.getElementById("tipTitle").innerText="نصيحة رقم "+(tipIndex+1);
document.getElementById("tipText").innerText=tips[tipIndex];
}
function nextTip(){tipIndex=(tipIndex+1)%tips.length;renderTip();}

function saveName(){
let name=document.getElementById("username").value.trim();
if(!name){alert("اكتب اسمك أولاً.");return;}
localStorage.setItem("cyvoraUser",name);
updateAll();
alert("تم حفظ الاسم.");
}
function updateAll(){
points=getNumber("cyvoraPoints");
best=getNumber("cyvoraBest");
lessons=JSON.parse(localStorage.getItem("cyvoraLessons")||"[false,false,false,false]");
document.getElementById("points").innerText=points;
document.getElementById("best").innerText=best;
document.getElementById("lessonCount").innerText=lessons.filter(Boolean).length;
document.getElementById("level").innerText=points>=100?"متقدم":points>=40?"متوسط":"مبتدئ";
document.getElementById("achievements").innerText=lessons.filter(Boolean).length+" دروس مكتملة من 4";
let name=localStorage.getItem("cyvoraUser")||"زائر";
document.getElementById("savedName").innerText=name;
document.getElementById("username").value=name==="زائر"?"":name;
document.getElementById("profilePoints").innerText=points;
document.getElementById("profileStatus").innerText=lessons.every(Boolean)?"أكملت جميع الدروس":"مستمر في التعلم";
}
renderQuiz();
renderDaily();
renderTip();
updateAll();
</script>
</body>
</html>
